# Optional runtime settings. This file is loaded automatically via python-dotenv.

# Emit diagnostic log lines as JSON on stderr (1/true/yes/on). Overridden by
# the --log-format CLI flag. Logs always go to stderr; stdout stays clean.
LOG_JSON=0

# Correlation id attached to the analysis_complete / analysis_failed events.
# Set one shared id per batch so per-issue runs correlate; a fresh id is
# generated per run when unset.
RUN_ID=

# Directory for per-run_id batch state files used by --batch-size. Defaults to
# a temp dir (va_legal_agent_batches) when unset.
BATCH_STATE_DIR=

# Timeout in seconds for each outbound search/fetch request.
REQUEST_TIMEOUT_SECONDS=20

# Cap on downloaded response size in bytes (20 MiB). Protects against runaway
# downloads; raise it for very large opinion files.
MAX_FETCH_BYTES=20971520

# Number of court-site search queries to run concurrently.
SEARCH_MAX_WORKERS=4

# Stagger in seconds between starting consecutive search queries (0 disables).
# Queries still overlap under SEARCH_MAX_WORKERS; this softens the burst.
SEARCH_DELAY_SECONDS=0.5

# Retries for throttled/transient DuckDuckGo responses (extra attempts after
# the first; 0 disables retries). Uses exponential backoff between retries.
SEARCH_RETRY_ATTEMPTS=2

# Base delay (seconds) for the retry backoff; doubled each attempt.
SEARCH_BACKOFF_BASE_SECONDS=1.0

# Cap on the retry backoff delay (seconds).
SEARCH_BACKOFF_MAX_SECONDS=10.0

# Global minimum seconds between DuckDuckGo requests (0 disables). Enforced
# across concurrent search workers so they can't burst the provider.
SEARCH_MIN_INTERVAL_SECONDS=0

# Cap on total wall time (seconds) spent searching for one issue (0 disables).
# Once exhausted, remaining queries are abandoned: results already found are
# returned and an in-flight query stops cooperatively between provider calls.
# Lets operators bound runs without tuning the nested retry loops; can be
# overridden per run with --max-wall-time.
SEARCH_MAX_WALL_SECONDS=0

# Comma-separated search providers to run: duckduckgo (default), courtlistener
# (structured CAVC/Federal Circuit/SCOTUS metadata), and/or bva (Board of
# Veterans' Appeals decisions via search.usa.gov).
SEARCH_PROVIDERS=duckduckgo

# Pages of results fetched per query per provider (1 fetches only page 1;
# >1 deepens recall, subject to throttling).
SEARCH_PAGES_PER_QUERY=1

# Per-provider overrides of SEARCH_PAGES_PER_QUERY, e.g. bva=1 pins the Board
# index to page 1 (search.usa.gov rate-limits pagination hard) while
# duckduckgo=4 deepens recall there. Unlisted providers fall back to the
# global setting; every provider still fetches at least 1 page. Format:
# comma-separated provider=count pairs.
SEARCH_PAGES_PER_QUERY_BY_PROVIDER=

# Additional variant queries derived from topic synonyms and statute hints
# (0 disables expansion).
SEARCH_QUERY_VARIANTS=3

# Per-provider overrides of SEARCH_QUERY_VARIANTS, e.g. bva=0 disables
# expansion on search.usa.gov (which rate-limits extra queries hard) while
# courtlistener=5 deepens it there. Unlisted providers fall back to the
# global setting. Format: comma-separated provider=count pairs.
SEARCH_QUERY_VARIANTS_BY_PROVIDER=

# CourtListener API token (free account). Required: v4 returns 401 for
# anonymous requests.
COURTLISTENER_API_KEY=

# Top cases enriched with full source-page details.
ENRICH_CASE_LIMIT=5

# Top cases fed into the interpretation narrative / LLM.
INTERPRET_CASE_LIMIT=3

# Cases scanned for case-backed principle findings.
PRINCIPLE_SCAN_LIMIT=5

# Optional: OpenAI (or Azure OpenAI-compatible endpoint) for case-specific
# interpretation of the top results. Requires the optional dependency:
#   pip install openai   (or: pip install -e ".[llm]")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Timeout (seconds) for each OpenAI completion request.
OPENAI_TIMEOUT_SECONDS=60

# Maximum completion tokens for the interpretation narrative.
OPENAI_MAX_TOKENS=700

OPENAI_BASE_URL=

# Reconcile holdings across all ranked cases via the LLM: derive reconciled
# principles (with inline citations), flag contradictions between decisions,
# and produce a citing synthesis. 0 keeps only the lighter single-call
# narrative. The deterministic template is always the fallback.
LLM_REASONING=1

# Ranked cases fed into the reconciling reasoning pass.
LLM_REASONING_LIMIT=10

# Deep-read mode: fetch the full opinion text of the top cases and summarize
# it via chunked map-reduce, so the reasoning pass cross-references holdings
# across the whole corpus instead of truncated snippets. Off by default because
# it fetches the entire body of every top case. Override per run with the
# --deep-read / --no-deep-read CLI flags (they beat this env value).
DEEP_READ=0

# Top cases ingested in deep-read mode. Override per run with --deep-read-limit
# (still capped by the number of cases found).
DEEP_READ_LIMIT=3

# PDF page cap for deep-read fetches (0 reads every page).
DEEP_READ_PAGES=0

# Approximate character size of each chunk in the map-reduce pass.
DEEP_CHUNK_CHARS=6000
