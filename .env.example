# Optional runtime settings. This file is loaded automatically via python-dotenv.

# Emit diagnostic log lines as JSON on stderr (1/true/yes/on). Overridden by
# the --log-format CLI flag. Logs always go to stderr; stdout stays clean.
LOG_JSON=0

# Correlation id attached to the analysis_complete / analysis_failed events.
# Set one shared id per batch so per-issue runs correlate; a fresh id is
# generated per run when unset.
RUN_ID=

# Directory for per-run_id batch state files used by --batch-size. Defaults to
# a temp dir (va_legal_agent_batches) when unset.
BATCH_STATE_DIR=

# Web app (Flask). It binds only to 127.0.0.1; do not expose it publicly.
# Port used by `python -m webapp` (1-65535).
PORT=8080

# Directory for persisted web-app jobs. Relative paths resolve from the
# working directory; keep the default when running from the repo root.
WEBAPP_STATE_DIR=.webapp

# Maximum concurrent web-app analyses (1-32); extra submissions receive HTTP 429.
WEBAPP_MAX_CONCURRENT=2

# Timeout in seconds for each outbound search/fetch request.
REQUEST_TIMEOUT_SECONDS=20

# Cap on downloaded response size in bytes (20 MiB). Protects against runaway
# downloads; raise it for very large opinion files.
MAX_FETCH_BYTES=20971520

# HTTP User-Agent sent by the fetch layer (enrichment / deep-read) and the
# CourtListener provider. NOT sent to DuckDuckGo or BVA: those use curl_cffi
# browser impersonation, and a custom bot-identifying UA would re-trigger
# their bot blocks.
USER_AGENT=Mozilla/5.0 (compatible; VA-Legal-Agent/1.0; veterans-law research assistant)

# Optional HTTP(S) proxy URL for the search layer (DuckDuckGo, CourtListener,
# BVA). When set, every search request routes through it, so a flagged local IP
# can be swapped for a residential proxy. Example:
#   SEARCH_HTTP_PROXY=http://user:pass@residential-proxy.example:8080
# Empty = connect directly.
SEARCH_HTTP_PROXY=

# Number of court-site search queries to run concurrently.
SEARCH_MAX_WORKERS=4

# Stagger in seconds between starting consecutive search queries (0 disables).
# Queries still overlap under SEARCH_MAX_WORKERS; this softens the burst.
SEARCH_DELAY_SECONDS=0.5

# Retries for throttled/transient DuckDuckGo responses (extra attempts after
# the first; 0 disables retries). Uses exponential backoff between retries.
SEARCH_RETRY_ATTEMPTS=2

# Base delay (seconds) for the retry backoff; doubled each attempt.
SEARCH_BACKOFF_BASE_SECONDS=1.0

# Cap on the retry backoff delay (seconds).
SEARCH_BACKOFF_MAX_SECONDS=10.0

# Global minimum seconds between DuckDuckGo requests (0 disables). Enforced
# across concurrent search workers so they can't burst the provider.
SEARCH_MIN_INTERVAL_SECONDS=0

# Cap on total wall time (seconds) spent searching for one issue (0 disables).
# Once exhausted, remaining queries are abandoned: results already found are
# returned and an in-flight query stops cooperatively between provider calls.
# Lets operators bound runs without tuning the nested retry loops; can be
# overridden per run with --max-wall-time.
SEARCH_MAX_WALL_SECONDS=0

# Deterministic cap on gap-refinement rounds in the research loop. Even with
# SEARCH_MAX_WALL_SECONDS=0 (deadline disabled), a pathological ready-filter
# (or a refine_plan that keeps minting fresh tasks) must not spin the re-search
# loop forever; the loop stops after this many refinement rounds.
SEARCH_MAX_REFINEMENT_ROUNDS=3

# Comma-separated search providers to run: duckduckgo (default), courtlistener
# (structured CAVC/Federal Circuit/SCOTUS metadata), bva (Board decisions via
# search.usa.gov), bvasitemap (Board decisions direct from the official va.gov
# sitemap index — WAF-free, current-year recent decisions only), and/or
# bvalocal (full-corpus local index — sub-second, completely WAF-free).
SEARCH_PROVIDERS=duckduckgo

# Pages of results fetched per query per provider (1 fetches only page 1;
# >1 deepens recall, subject to throttling).
SEARCH_PAGES_PER_QUERY=1

# Per-provider overrides of SEARCH_PAGES_PER_QUERY, e.g. bva=1 pins the Board
# index to page 1 (search.usa.gov rate-limits pagination hard) while
# duckduckgo=4 deepens recall there. Unlisted providers fall back to the
# global setting; every provider still fetches at least 1 page. Format:
# comma-separated provider=count pairs.
SEARCH_PAGES_PER_QUERY_BY_PROVIDER=

# Additional variant queries derived from topic synonyms and statute hints
# (0 disables expansion).
SEARCH_QUERY_VARIANTS=3

# Per-provider overrides of SEARCH_QUERY_VARIANTS, e.g. bva=0 disables
# expansion on search.usa.gov (which rate-limits extra queries hard) while
# courtlistener=5 deepens it there. Unlisted providers fall back to the
# global setting. Format: comma-separated provider=count pairs.
SEARCH_QUERY_VARIANTS_BY_PROVIDER=


# Comma-separated exclusion terms (case-insensitive) that suppress results
# whose title or snippet contains any of them. E.g. knee,back,elbow drops
# BVA decisions about unrelated conditions that mention the issue only in
# the procedural history. The DuckDuckGo provider also appends -term
# operators to query strings; the post-fetch filter catches all providers.
# Empty = no filtering.
SEARCH_EXCLUDE_TERMS=

# Per-provider requests-per-minute budget, e.g. courtlistener=5,bva=3 caps
# each backend at N requests/minute (60/N seconds apart). Enforced on top of
# SEARCH_MIN_INTERVAL_SECONDS, regardless of worker/variant count, so a batch
# can't burst past the limit. Unlisted providers have no budget; 0 disables
# for that provider. Format: comma-separated provider=rpm pairs.
SEARCH_MAX_RPM_BY_PROVIDER=

# How many of the most recent BVA decision files the bvasitemap provider
# scans per query. The va.gov sitemap (sitemap_bva.xml) enumerates tens of
# thousands of decisions per year, so the provider bounds its per-query
# file fetches to the newest N and greps those for the issue phrase.
SEARCH_BVA_SITEMAP_SCAN_LIMIT=200
# On-disk directory where the bvalocal provider stores one shard per
# BVA year (corpus-YYYY.txt + manifest-YYYY.json). Set to empty to disable.
SEARCH_BVA_LOCAL_INDEX_DIR=.bva_index
# How many recent years from the official sitemap to index, newest-first.
SEARCH_BVA_LOCAL_INDEX_YEARS=5
# How many of the most recent files to download per year shard on build
# (0 = every file in each selected year).
SEARCH_BVA_LOCAL_INDEX_MAX_FILES=0
# Maximum age (hours) before each year shard is auto-rebuilt
# (0 = never auto-rebuild).
SEARCH_BVA_LOCAL_INDEX_MAX_AGE_HOURS=24

# Cap on results merged per search query. Raise it (e.g. 30) for multi-provider
# runs (SEARCH_PROVIDERS) so a backend listed first can't fill the cap alone
# and starve the others. Override per run with --max-results.
SEARCH_MAX_RESULTS=10

# CourtListener API token (free account). Required: v4 returns 401 for
# anonymous requests.
COURTLISTENER_API_KEY=

# Pre-flight check against CourtListener's api-usage endpoint before each run:
# when the free-tier daily budget (125 requests/day, rolling) can't cover the
# estimated run cost (queries x variants x pages), the run aborts with the
# window reset time instead of grinding through 429s. The check uses the
# usage endpoint's own throttle, so it doesn't burn the search budget.
# Set 0 to disable.
COURTLISTENER_USAGE_GUARD=1

# Selective CourtListener semantic search during gap refinement: one
# plain-language query per refinement round, never for the initial broad
# fan-out. Requires COURTLISTENER_API_KEY; off by default because it consumes
# CourtListener quota.
COURTLISTENER_SEMANTIC_GAP_SEARCH=0

# Validate CAVC decisions against the court's official Panel Opinions list:
# panel-listed dockets are precedential, while Rule 30(a) single-judge
# dispositions are not citable as precedent. Off by default because it fetches
# the official list.
CAVC_PANEL_VALIDATION=0

# Verify cited regulations/statutes and Federal Circuit cases against eCFR, the
# Federal Register, and (when GOVINFO_API_KEY is set) GovInfo. Also emits a
# separate provision-level statutory/regulatory supersession signal; it never
# changes case superseded_by or citator status. Off by default because analysis
# then makes external HTTP requests.
AUTHORITY_VERIFICATION=0

# How far back to search the Federal Register for rules affecting a cited CFR
# part or provision (1-3650 days).
FEDERAL_REGISTER_LOOKBACK_DAYS=365

# api.data.gov key for GovInfo's official U.S. Code and U.S. Courts Opinions
# search API. Optional; GovInfo checks are skipped when empty.
GOVINFO_API_KEY=

# Multi-hop citation traversal over CourtListener's citation graph: follow
# citation trails from the strongest cases found and merge the discovered
# opinions before final ranking. Off by default because it makes extra
# authenticated API calls per run; opt in for deeper trail-following recall.
CITATION_TRAVERSAL=0

# How many top cases seed the citation traversal.
CITATION_TRAVERSE_LIMIT=3

# Conservative CourtListener citator for a prioritized authority queue.
# Resolves each selected target's full cluster and all parallel citations,
# reviews forward citing opinions across every sub-opinion, and reports explicit
# negative treatment with verbatim excerpts. The queue puts higher court tiers,
# resolvable, live, and precedential authorities first; it is not a ranking
# change. Only a lead/majority/combined/unanimous Published opinion can set
# negative; separate, plurality, nonprecedential, and unknown-status findings
# are gated and force unknown. good_law means only that no authoritative
# negative treatment was found in the reviewed citing opinions. Same-docket
# decisions and later citing opinions are separate advisory signals. The
# appellate-history layer turns those signals into candidates; it never infers
# an appeal or exposes a history label without a human-verified record. Off by
# default because it consumes authenticated API requests. Advisory only: it
# does not change ranking or superseded_by.
CITATOR=0
# Maximum authorities checked from the queue (1-10). Lower this when
# CourtListener quota is tight; omitted cases are not implicitly clean.
CITATOR_MAX_CASES=10
# Lower this when CourtListener quota is tight; incomplete coverage is always
# reported rather than treated as clean.
CITATOR_MAX_CITING_OPINIONS=5
CITATOR_MAX_PAGES=1
# Optional inclusive as-of cutoff (YYYY-MM-DD). Only citing opinions dated on
# or before this value affect status and coverage. Later treatment is reported
# separately and never counted toward as-of status. Source-validity history
# also stops at this cutoff; later source history cannot invalidate a source
# for an as-of result. A citing opinion with no usable date is excluded and
# makes as-of coverage incomplete. Empty disables the cutoff.
CITATOR_AS_OF_DATE=
# Opt-in source-validity signals. Findings now always retain the source
# opinion id and cluster id; turning this on adds a source_validity list to
# each check. In extract mode the list records identifiers from metadata
# already fetched and makes no new requests. Extract and advisory modes do not
# change status or queue order; enforce opts into conservative status and queue
# enforcement. Off by default.
CITATOR_SOURCE_VALIDITY=0
# Source-validity mode: extract (default) preserves the lookup-free identifier
# list; advisory performs bounded one-hop validation and adds source statuses
# and reasons without status or queue changes; enforce additionally withholds
# non-authoritative sources, filters them from queue demotion, and recomputes
# status conservatively. Enforcement is opt-in and requires
# CITATOR_SOURCE_VALIDITY=1. Known lower-court sources stay visible but are
# marked withheld=true and are excluded from enforcement. Raw findings remain
# for audit; blocked sources are omitted from the derived treatment views but
# stay in the adjudication queue as low-priority withheld items. Source
# history can invalidate only when the later finding is binding and
# unambiguously attributed and the immediate invalidator's own bounded status
# is valid. Every relevant candidate is exposed in invalidator_checks with a
# review_status (reviewed, gated, unreviewed, metadata_failed,
# metadata_unavailable, text_failed, text_empty, target_not_located, or
# out_of_scope), a stable reason_code, and a human-readable reason. This
# includes cap-unreviewed, read-failed, and as-of-excluded candidates, even
# when no finding was obtained; without an accepted candidate, the source is
# unverified. As-of source-history review stops at the cutoff; excluded
# candidates remain visible as out_of_scope.
CITATOR_SOURCE_VALIDITY_MODE=extract

# Optional JSON file of human-verified appellate-history records. A record is
# exposed as a history label only when it matches the target by cluster id or
# citation, carries an official/licensed source URL, and includes the reviewer,
# timestamp, relationship, disposition, scope, and rationale. Without this file
# the layer reports candidates as insufficient_source, never "no history".
APPELLATE_HISTORY_FILE=

# Optional directory for durable evidence and CourtListener response snapshots.
# The citator writes an append-only manifest.jsonl plus content-addressed
# snapshots/<kind>/<id>.json payloads. Empty disables snapshotting. Only public
# provider payloads and request identifiers are stored; auth headers and API
# keys are never captured. Requires CITATOR=1 and COURTLISTENER_API_KEY.
SNAPSHOT_DIR=

# Top cases enriched with full source-page details.
ENRICH_CASE_LIMIT=5

# Top cases fed into the interpretation narrative / LLM.
INTERPRET_CASE_LIMIT=3

# Cases scanned for case-backed principle findings.
PRINCIPLE_SCAN_LIMIT=5

# Optional: OpenAI (or Azure OpenAI-compatible endpoint) for case-specific
# interpretation of the top results. Requires the optional dependency:
#   pip install openai   (or: pip install -e ".[llm]")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Timeout (seconds) for each OpenAI completion request.
OPENAI_TIMEOUT_SECONDS=60

# Maximum completion tokens for the interpretation narrative.
OPENAI_MAX_TOKENS=700

OPENAI_BASE_URL=

# Reconcile holdings across all ranked cases via the LLM: derive reconciled
# principles (with inline citations), flag contradictions between decisions,
# and produce a citing synthesis. 0 keeps only the lighter single-call
# narrative. The deterministic template is always the fallback.
LLM_REASONING=1

# Ranked cases fed into the reconciling reasoning pass.
LLM_REASONING_LIMIT=10

# Quote-first LLM extraction: request verbatim source quotes for case fields,
# verify each quote against the fetched decision, and expose only
# candidate-level proposals. Deterministic fields remain authoritative and are
# never overwritten. Off by default (one extra LLM call per enriched case).
LLM_EXTRACTION=0

# Deep-read mode: fetch the full opinion text of the top cases and summarize
# it via chunked map-reduce, so the reasoning pass cross-references holdings
# across the whole corpus instead of truncated snippets. Off by default because
# it fetches the entire body of every top case. Override per run with the
# --deep-read / --no-deep-read CLI flags (they beat this env value).
DEEP_READ=0

# Top cases ingested in deep-read mode. Override per run with --deep-read-limit
# (still capped by the number of cases found).
DEEP_READ_LIMIT=3

# PDF page cap for deep-read fetches (0 reads every page).
DEEP_READ_PAGES=0

# Approximate character size of each chunk in the map-reduce pass.
DEEP_CHUNK_CHARS=6000
